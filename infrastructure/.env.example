# Export Terraform-specific variables from existing .env.prod variables
export TF_VAR_aws_region="${AWS_REGION:-eu-central-1}"
export TF_VAR_project_name="${PROJECT_NAME:-opendata-stack-platform}"
export TF_VAR_environment="${ENVIRONMENT:-prod}"

# Snowflake Connection (for Terraform provider)
export TF_VAR_snowflake_account="${SNOWFLAKE_ACCOUNT}"
export TF_VAR_snowflake_admin_user="${SNOWFLAKE_ADMIN_USER}"
export TF_VAR_snowflake_admin_password="${SNOWFLAKE_PASSWORD}"

# Snowflake Database Configuration
export TF_VAR_snowflake_database_name="${SNOWFLAKE_DATABASE:-NYC_DATABASE}"
export TF_VAR_snowflake_warehouse_name="${SNOWFLAKE_WAREHOUSE:-COMPUTE_WH}"

# Data Engineer User Configuration
export TF_VAR_data_engineer_username="${DESTINATION__SNOWFLAKE__CREDENTIALS__USERNAME}"
export TF_VAR_data_engineer_password="${DESTINATION__SNOWFLAKE__CREDENTIALS__PASSWORD}"
export TF_VAR_data_engineer_email="${DATA_ENGINEER_EMAIL:-}"

# Warehouse Configuration
export TF_VAR_warehouse_size="${WAREHOUSE_SIZE:-X-SMALL}"
export TF_VAR_warehouse_auto_suspend="${WAREHOUSE_AUTO_SUSPEND:-60}"
