# Environment: Development
ENVIRONMENT=dev

# ============================================================================
# MinIO (S3-compatible storage)
# ============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

AWS_ACCOUNT=dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
AWS_S3_ALLOW_UNSAFE_RENAME=TRUE

S3_BUCKET=datalake
PROGRESS=enlighten

# For taxi_trip source
SOURCES__TAXI_TRIP__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=miniouser
SOURCES__TAXI_TRIP__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=miniouser
SOURCES__TAXI_TRIP__FILESYSTEM__CREDENTIALS__ENDPOINT_URL=http://localhost:9000
